{% doc %}
  @prompt
    Add a black rectangle badge above the product title on the product page. The badge should display a short customizable text describing what the product does (e.g. "Supports Neck & Back Comfort"). It should be styled as a solid black rectangle with white text, small font size, uppercase letters, and positioned directly above the product title.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-badge-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-product-badge-container-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    font-weight: {{ block.settings.font_weight }};
    margin-bottom: {{ block.settings.margin_bottom }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }
{% endstyle %}

<div class="ai-product-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.badge_text != blank %}
    <div class="ai-product-badge-container-{{ ai_gen_id }}">
      {{ block.settings.badge_text }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product badge",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Supports Neck & Back Comfort"
    },
    {
      "type": "header",
      "content": "Badge style"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Font size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "badge_padding_vertical",
      "label": "Vertical padding",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "badge_padding_horizontal",
      "label": "Horizontal padding",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Space below badge",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Product badge"
    }
  ]
}
{% endschema %}