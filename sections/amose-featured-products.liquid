{%- liquid
  assign s = section.settings
  assign amose_install_origin = 'https://amosesection1-production.up.railway.app'
  assign amose_status_script_url = amose_install_origin | append: '/amose-section-status.js'
  assign amose_skip_install_mask = false
  if request.design_mode
    assign amose_skip_install_mask = true
  endif
  if theme.role == 'development'
    assign amose_skip_install_mask = true
  endif

  assign featured_collection = s.collection
  if featured_collection == blank and collections.all != blank
    assign featured_collection = collections.all
  endif

  assign products_limit = s.products_to_show | default: 8
  assign columns_desktop = s.columns_desktop | default: 4
  assign columns_mobile = s.columns_mobile | default: 2
-%}

{%- style -%}
  #shopify-section-{{ section.id }}.amose-fp-root {
    --fp-bg: {{ s.section_bg | default: '#ffffff' }};
    --fp-panel: {{ s.panel_bg | default: '#f2f1ed' }};
    --fp-text: {{ s.text_color | default: '#1a1a1a' }};
    --fp-muted: {{ s.muted_color | default: '#6b6b6b' }};
    --fp-price: {{ s.price_color | default: '#1a1a1a' }};
    --fp-sale: {{ s.sale_color | default: '#c41e3a' }};
    --fp-radius: {{ s.card_radius | default: 12 }}px;
    --fp-gap: {{ s.card_gap | default: 16 }}px;
    --fp-aspect: {{ s.image_aspect_ratio | default: '1 / 1' }};
    --fp-cols: {{ columns_desktop }};
    --fp-mobile-cols: {{ columns_mobile }};
    --fp-pad-x: clamp(16px, 3vw, 28px);
    background: var(--fp-bg);
    color: var(--fp-text);
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}.amose-fp-root {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .amose-fp {
    max-width: {{ s.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 var(--fp-pad-x);
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-fp {
      {% if s.desktop_width == 'full' %}
        padding: 0;
        max-width: none;
      {% endif %}
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .amose-fp {
      {% if s.mobile_width == 'full' %}
        padding: 0;
        max-width: none;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .amose-fp__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(20px, 3vw, 28px);
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .amose-fp__heading-wrap {
    min-width: 0;
    flex: 1 1 auto;
  }

  #shopify-section-{{ section.id }} .amose-fp__heading {
    margin: 0 0 {% if s.subtext != blank %}8px{% else %}0{% endif %};
    font-size: clamp(24px, 2.8vw, {{ s.heading_size | default: 34 }}px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: {{ s.heading_weight | default: 700 }};
    color: var(--fp-text);
  }

  #shopify-section-{{ section.id }} .amose-fp__sub {
    margin: 0;
    max-width: 42ch;
    font-size: {{ s.body_size | default: 15 }}px;
    line-height: 1.55;
    color: var(--fp-muted);
  }

  #shopify-section-{{ section.id }} .amose-fp__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 10px 18px;
    border: 1px solid var(--fp-text);
    border-radius: {{ s.button_border_radius | default: 40 }}px;
    background: transparent;
    color: var(--fp-text);
    font-size: {{ s.button_font_size | default: 12 }}px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.2;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .amose-fp__cta:hover {
    opacity: 0.72;
  }

  #shopify-section-{{ section.id }} .amose-fp__grid {
    display: grid;
    grid-template-columns: repeat(var(--fp-mobile-cols), minmax(0, 1fr));
    gap: var(--fp-gap);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-fp__grid {
      grid-template-columns: repeat(var(--fp-cols), minmax(0, 1fr));
    }
  }

  #shopify-section-{{ section.id }} .amose-fp[data-display='slider'] .amose-fp__grid {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-display='slider'] .amose-fp__grid::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .amose-fp__card {
    margin: 0;
    background: var(--fp-panel);
    border-radius: var(--fp-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-card-surface='plain'] .amose-fp__card {
    background: transparent;
    border-radius: 0;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-display='slider'] .amose-fp__card {
    flex: 0 0 calc((100% - (var(--fp-gap) * (var(--fp-mobile-cols) - 1))) / var(--fp-mobile-cols));
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-fp[data-display='slider'] .amose-fp__card {
      flex-basis: calc((100% - (var(--fp-gap) * (var(--fp-cols) - 1))) / var(--fp-cols));
    }
  }

  #shopify-section-{{ section.id }} .amose-fp__media {
    display: block;
    position: relative;
    aspect-ratio: var(--fp-aspect);
    overflow: hidden;
    background: #e8e8e8;
    text-decoration: none;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .amose-fp__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .amose-fp__card:hover .amose-fp__media img {
    transform: scale(1.03);
  }

  #shopify-section-{{ section.id }} .amose-fp__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #ececec 0%, #d8d8d8 100%);
  }

  #shopify-section-{{ section.id }} .amose-fp__body {
    padding: 14px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 auto;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-card-surface='plain'] .amose-fp__body {
    padding: 14px 0 0;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-card-surface='plain'] .amose-fp__media {
    border-radius: var(--fp-radius);
  }

  #shopify-section-{{ section.id }} .amose-fp__vendor {
    margin: 0;
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fp-muted);
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .amose-fp__title {
    margin: 0;
    font-size: {{ s.title_size | default: 15 }}px;
    line-height: 1.35;
    font-weight: 600;
    color: var(--fp-text);
  }

  #shopify-section-{{ section.id }} .amose-fp__title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .amose-fp__title a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .amose-fp__price {
    margin: 0;
    font-size: {{ s.price_size | default: 14 }}px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--fp-price);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-text-align='left'] .amose-fp__body {
    text-align: left;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-text-align='center'] .amose-fp__body {
    text-align: center;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-text-align='right'] .amose-fp__body {
    text-align: right;
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-text-align='center'] .amose-fp__price {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .amose-fp[data-text-align='right'] .amose-fp__price {
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .amose-fp__compare {
    color: var(--fp-muted);
    font-weight: 500;
    text-decoration: line-through;
    font-size: 0.92em;
  }

  #shopify-section-{{ section.id }} .amose-fp__sale {
    color: var(--fp-sale);
  }

  #shopify-section-{{ section.id }} .amose-fp__empty {
    margin: 0;
    padding: 32px 0;
    text-align: center;
    color: var(--fp-muted);
    font-size: 15px;
    line-height: 1.5;
  }
{%- endstyle -%}

{%- unless amose_skip_install_mask -%}
{%- style -%}
  #shopify-section-{{ section.id }}.amose-section-checking {
    display: none !important;
  }
{%- endstyle -%}
{%- endunless -%}

<div
  class="amose-fp"
  data-display="{{ s.display_style | default: 'columns' }}"
  data-text-align="{{ s.card_text_alignment | default: 'left' }}"
  data-card-surface="{% if s.show_card_background == false %}plain{% else %}panel{% endif %}"
>
  <div class="amose-fp__header">
    <div class="amose-fp__heading-wrap">
      {% if s.heading != blank %}
        <h2 class="amose-fp__heading">{{ s.heading | escape }}</h2>
      {% endif %}
      {% if s.subtext != blank %}
        <p class="amose-fp__sub">{{ s.subtext | escape }}</p>
      {% endif %}
    </div>

    {% if s.show_view_all and featured_collection != blank and s.view_all_label != blank %}
      <a class="amose-fp__cta" href="{{ featured_collection.url }}">{{ s.view_all_label | escape }}</a>
    {% endif %}
  </div>

  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <div class="amose-fp__grid" role="list">
      {% for product in featured_collection.products limit: products_limit %}
        <article class="amose-fp__card" role="listitem">
          <a class="amose-fp__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image != blank %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            {% else %}
              <div class="amose-fp__placeholder" aria-hidden="true"></div>
            {% endif %}
          </a>
          <div class="amose-fp__body">
            {% if s.show_vendor and product.vendor != blank %}
              <p class="amose-fp__vendor">{{ product.vendor | escape }}</p>
            {% endif %}
            <h3 class="amose-fp__title">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h3>
            {% if s.show_price %}
              <p class="amose-fp__price">
                {% if product.compare_at_price > product.price %}
                  <span class="amose-fp__compare">{{ product.compare_at_price | money }}</span>
                  <span class="amose-fp__sale">{{ product.price | money }}</span>
                {% else %}
                  <span>{{ product.price | money }}</span>
                {% endif %}
              </p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p class="amose-fp__empty">
      {% if request.design_mode %}
        Choose a collection in section settings to show featured products.
      {% else %}
        {{ s.empty_message | default: 'No products to show yet.' | escape }}
      {% endif %}
    </p>
  {% endif %}
</div>

{%- unless amose_skip_install_mask -%}
<script>
  window.__AmoseInstallCheckPageStart = window.__AmoseInstallCheckPageStart || Date.now();
  window.__AmoseInstallCheckOrigin = {{ amose_install_origin | json }};
  window.AmoseSectionStatus = window.AmoseSectionStatus || [];
  window.AmoseSectionStatus.push({
    shop: {{ shop.permanent_domain | json }},
    sectionId: {{ section.id | json }},
    sectionType: "featured-products"
  });

  window.AmoseStatusLoaderInserted = window.AmoseStatusLoaderInserted || false;
  if (!window.AmoseStatusLoaderInserted) {
    window.AmoseStatusLoaderInserted = true;
    var script = document.createElement("script");
    script.src = {{ amose_status_script_url | json }};
    script.defer = true;
    document.head.appendChild(script);
  }
</script>
{%- endunless -%}

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "amose-fp-root",
  "settings": [
    { "type": "range", "id": "max_width", "min": 960, "max": 1600, "step": 20, "unit": "px", "label": "Max width", "default": 1200 },
    { "type": "header", "content": "Collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Hand-picked favorites from this collection." },
    {
      "type": "range",
      "id": "heading_size",
      "min": 22,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 34
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "700",
      "options": [
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Button border radius",
      "default": 40
    },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "text", "id": "empty_message", "label": "Empty state message", "default": "No products to show yet." },
    { "type": "header", "content": "Product cards" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select",
      "id": "display_style",
      "label": "Display style",
      "default": "columns",
      "options": [
        { "value": "columns", "label": "Columns" },
        { "value": "slider", "label": "Slider" }
      ]
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image format",
      "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "1:1 (Square)" },
        { "value": "4 / 5", "label": "4:5 (Portrait)" },
        { "value": "3 / 4", "label": "3:4 (Portrait)" },
        { "value": "16 / 10", "label": "16:10 (Landscape)" }
      ]
    },
    { "type": "range", "id": "card_gap", "min": 8, "max": 32, "step": 1, "unit": "px", "label": "Card gap", "default": 16 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 32, "step": 1, "unit": "px", "label": "Card radius", "default": 12 },
    { "type": "checkbox", "id": "show_card_background", "label": "Show card background", "default": true },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Card text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "range", "id": "title_size", "min": 13, "max": 18, "step": 1, "unit": "px", "label": "Title size", "default": 15 },
    { "type": "range", "id": "price_size", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Price size", "default": 14 },
    { "type": "range", "id": "body_size", "min": 13, "max": 18, "step": 1, "unit": "px", "label": "Subtext size", "default": 15 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop width",
      "default": "container",
      "options": [
        { "value": "container", "label": "In container" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile width",
      "default": "container",
      "options": [
        { "value": "container", "label": "In container" },
        { "value": "full", "label": "Full width" }
      ]
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "panel_bg", "label": "Card background", "default": "#f2f1ed" },
    { "type": "color", "id": "text_color", "label": "Heading & title", "default": "#1a1a1a" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6b6b6b" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#1a1a1a" },
    { "type": "color", "id": "sale_color", "label": "Sale price", "default": "#c41e3a" }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
