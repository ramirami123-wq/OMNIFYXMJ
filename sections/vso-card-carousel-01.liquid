{%- liquid
  assign enable_advanced_settings = section.settings.enable_advanced_settings

  assign section_bg_type = section.settings.section_bg_type
  assign section_bg_color = section.settings.section_bg_color
  assign section_bg_gradient = section.settings.section_bg_gradient
  assign full_width_desktop = section.settings.full_width_desktop
  assign section_border_radius = section.settings.section_border_radius
  assign section_border_radius_mobile = section.settings.section_border_radius_mobile
  assign section_padding_top = section.settings.section_padding_top
  assign section_padding_bottom = section.settings.section_padding_bottom
  assign section_padding_top_mobile = section.settings.section_padding_top_mobile
  assign section_padding_bottom_mobile = section.settings.section_padding_bottom_mobile
  assign section_horizontal_padding = section.settings.section_horizontal_padding
  assign section_horizontal_padding_mobile = section.settings.section_horizontal_padding_mobile
  assign section_max_width = section.settings.section_max_width

  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign margin_top_mobile = section.settings.margin_top_mobile
  assign margin_bottom_mobile = section.settings.margin_bottom_mobile

  assign heading = section.settings.heading
  assign heading_size = section.settings.heading_size
  assign heading_size_mobile = section.settings.heading_size_mobile
  assign heading_color = section.settings.heading_color
  assign heading_custom = section.settings.heading_custom
  assign heading_font = section.settings.heading_font
  assign heading_height = section.settings.heading_height
  assign heading_align = section.settings.heading_align
  assign title_margin_bottom_desktop = section.settings.title_margin_bottom_desktop

  assign percentage_size = section.settings.percentage_size
  assign percentage_size_mobile = section.settings.percentage_size_mobile
  assign percentage_color = section.settings.percentage_color

  assign card_title_size = section.settings.card_title_size
  assign card_title_size_mobile = section.settings.card_title_size_mobile
  assign card_title_color = section.settings.card_title_color
  assign card_title_custom = section.settings.card_title_custom
  assign card_title_font = section.settings.card_title_font
  assign card_title_height = section.settings.card_title_height

  assign card_description_size = section.settings.card_description_size
  assign card_description_size_mobile = section.settings.card_description_size_mobile
  assign card_description_color = section.settings.card_description_color
  assign card_description_custom = section.settings.card_description_custom
  assign card_description_font = section.settings.card_description_font
  assign card_description_height = section.settings.card_description_height

  assign card_text_align = section.settings.card_text_align
  assign card_elements_spacing = section.settings.card_elements_spacing

  assign items_per_row = section.settings.items_per_row
  assign items_per_row_tablet = section.settings.items_per_row_tablet
  assign items_per_row_mobile = section.settings.items_per_row_mobile
  assign items_gap = section.settings.items_gap
  assign desktop_peek_percentage = section.settings.desktop_peek_percentage
  assign mobile_peek_percentage = section.settings.mobile_peek_percentage

  assign card_padding_vertical = section.settings.card_padding_vertical
  assign card_padding_horizontal = section.settings.card_padding_horizontal
  assign card_border_radius = section.settings.card_border_radius
  assign card_border_width = section.settings.card_border_width
  assign card_border_color = section.settings.card_border_color
  assign card_bg_color = section.settings.card_bg_color

  assign enable_autoplay = section.settings.enable_autoplay
  assign autoplay_speed = section.settings.autoplay_speed
  assign scroll_behavior = section.settings.scroll_behavior

  assign enable_navigation_desktop = section.settings.enable_navigation_desktop
  assign enable_navigation_mobile = section.settings.enable_navigation_mobile
  assign nav_margin_top = section.settings.nav_margin_top
  assign nav_line_height = section.settings.nav_line_height
  assign nav_line_color = section.settings.nav_line_color
  assign nav_line_border_radius = section.settings.nav_line_border_radius
  assign nav_line_arrow_gap = section.settings.nav_line_arrow_gap
  assign nav_arrow_size = section.settings.nav_arrow_size
  assign nav_arrow_gap = section.settings.nav_arrow_gap
  assign nav_arrow_color = section.settings.nav_arrow_color
  assign nav_arrow_border_color = section.settings.nav_arrow_border_color
  assign nav_arrow_bg = section.settings.nav_arrow_bg
  assign nav_arrow_border_width = section.settings.nav_arrow_border_width
  assign transition_duration = section.settings.transition_duration
  assign progress_bg_color = section.settings.progress_bg_color
  assign progress_filled_color = section.settings.progress_filled_color

  assign lazy = section.settings.lazy
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ card_title_font | font_face: font_display: 'swap' }}
  {{ card_description_font | font_face: font_display: 'swap' }}

  /* ── Section root (mobile-first) ── */
  #shopify-section-{{ section.id }} {
    --section-border-radius: {{ section_border_radius_mobile }}px;
    --section-horizontal-padding: var(--page-margin, 16px);
    margin-top: {{ margin_top_mobile }}px;
    margin-bottom: {{ margin_bottom_mobile }}px;
    border-radius: var(--section-border-radius);
    padding: 0;
  }

  @media screen and (max-width: 749px) {
    html:has(#shopify-section-{{ section.id }}) {
      overflow-x: hidden;
    }
    #shopify-section-{{ section.id }} {
      overflow: visible;
    }
    #shopify-section-{{ section.id }} > .vso-card-carousel__container {
      grid-column: 1 / -1;
      background: transparent;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      overflow: hidden;
    }
  }

  {% if enable_advanced_settings %}
    #shopify-section-{{ section.id }} {
      --section-horizontal-padding: {{ section_horizontal_padding_mobile }}px;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      {% if section_bg_type == 'gradient' %}
        background: {{ section_bg_gradient }};
      {% else %}
        background-color: {{ section_bg_color }};
      {% endif %}
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --section-border-radius: {% if full_width_desktop %}0{% else %}{{ section_border_radius }}{% endif %}px;
      --section-horizontal-padding: 0px;
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      {% if full_width_desktop %}
        {% if section_bg_type == 'gradient' %}
          background: {{ section_bg_gradient }};
        {% else %}
          background-color: {{ section_bg_color }};
        {% endif %}
      {% else %}
        background: transparent;
      {% endif %}
    }
  }

  {% if enable_advanced_settings == false and full_width_desktop == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: 40px;
      }
    }
  {% endif %}

  {% if enable_advanced_settings == false and full_width_desktop %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-container-max-width: var(--page-content-width, var(--page-width, 1440px));
        --section-outer-gutter: max(0px, calc((100vw - var(--section-container-max-width)) / 2));
        --section-horizontal-padding: max(0px, calc(var(--page-margin, 40px) - var(--section-outer-gutter)));
      }
    }
  {% endif %}

  {% if enable_advanced_settings %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: {{ section_horizontal_padding }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-node { display: none; }
  #shopify-section-{{ section.id }} .vso-node--v2 { display: block; }

  /* ── Container ── */
  #shopify-section-{{ section.id }} > .vso-card-carousel__container {
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    max-width: var(--page-content-width, var(--page-width, 1440px));
    {% if enable_advanced_settings %}
      max-width: {{ section_max_width }}rem;
    {% endif %}
    padding-left: var(--section-horizontal-padding);
    padding-right: var(--section-horizontal-padding);
    padding-top: {{ section_padding_top_mobile }}px;
    padding-bottom: {{ section_padding_bottom_mobile }}px;
    border-radius: var(--section-border-radius);
    box-sizing: border-box;
  }

  {% if full_width_desktop == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} > .vso-card-carousel__container {
        width: calc(100% - (2 * var(--page-margin, 40px)));
      }
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} > .vso-card-carousel__container {
      {% if full_width_desktop %}
        background: transparent;
      {% else %}
        {% if section_bg_type == 'gradient' %}
          background: {{ section_bg_gradient }};
        {% else %}
          background-color: {{ section_bg_color }};
        {% endif %}
      {% endif %}
      padding-top: {{ section_padding_top }}px;
      padding-bottom: {{ section_padding_bottom }}px;
    }
  }

  /* ── Heading ── */
  #shopify-section-{{ section.id }} .vso-card-carousel__heading {
    margin: 0;
    font-size: {{ heading_size_mobile }}px;
    color: {{ heading_color }};
    line-height: {{ heading_height }}%;
    text-align: {{ heading_align }};
    text-transform: unset;
    margin-bottom: {{ title_margin_bottom_desktop | times: 0.75 | round: 0 }}px;
  }

  {% if heading_custom %}
    #shopify-section-{{ section.id }} .vso-card-carousel__heading {
      font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      font-weight: {{ heading_font.weight }};
      font-style: {{ heading_font.style }};
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-card-carousel__heading {
      font-size: {{ heading_size }}px;
      margin-bottom: {{ title_margin_bottom_desktop }}px;
    }
  }

  /* ── Carousel ── */
  #shopify-section-{{ section.id }} .vso-card-carousel__carousel {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-behavior: {{ scroll_behavior }};
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    gap: {{ items_gap }}px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: var(--section-horizontal-padding);
    padding-right: var(--section-horizontal-padding);
    touch-action: pan-x;
    transition: all 0.2s ease;
    scroll-padding: 0 var(--section-horizontal-padding);
    margin-left: calc(var(--section-horizontal-padding) * -1);
    margin-right: calc(var(--section-horizontal-padding) * -1);
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__carousel::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__carousel.grabbing {
    scroll-behavior: auto;
    transition: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .vso-card-carousel__carousel {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      padding-left: var(--section-horizontal-padding);
      padding-right: var(--section-horizontal-padding);
      scroll-padding: 0 var(--section-horizontal-padding);
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-card-carousel__carousel {
      padding-right: {% if section.blocks.size > items_per_row %}{{ desktop_peek_percentage }}%{% else %}var(--section-horizontal-padding){% endif %};
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1279px) {
    #shopify-section-{{ section.id }} .vso-card-carousel__carousel {
      padding-right: {% if section.blocks.size > items_per_row_tablet %}{{ desktop_peek_percentage }}%{% else %}var(--section-horizontal-padding){% endif %};
    }
  }

  /* ── Cards ── */
  #shopify-section-{{ section.id }} .vso-card-carousel__card {
    flex: 0 0 auto;
    width: calc(100% - {{ mobile_peek_percentage }}%);
    scroll-snap-align: start;
    background-color: {{ card_bg_color }};
    border-radius: {{ card_border_radius }}px;
    padding: {{ card_padding_vertical | times: 0.75 | round: 0 }}px {{ card_padding_horizontal | times: 0.75 | round: 0 }}px;
    text-align: {{ card_text_align }};
    box-shadow: 0 3px 10px rgba(0,0,0,0.03);
    border: {{ card_border_width }}px solid {{ card_border_color }};
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__card:last-child {
    scroll-snap-align: end;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-card-carousel__card {
      width: calc((100% - ({{ items_per_row }} - 1) * {{ items_gap }}px - {% if section.blocks.size > items_per_row %}{{ desktop_peek_percentage }}%{% else %}0%{% endif %}) / {{ items_per_row }});
      padding: {{ card_padding_vertical }}px {{ card_padding_horizontal }}px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1279px) {
    #shopify-section-{{ section.id }} .vso-card-carousel__card {
      width: calc((100% - ({{ items_per_row_tablet }} - 1) * {{ items_gap }}px - {% if section.blocks.size > items_per_row_tablet %}{{ desktop_peek_percentage }}%{% else %}0%{% endif %}) / {{ items_per_row_tablet }});
    }
  }

  /* ── Card content ── */
  #shopify-section-{{ section.id }} .vso-card-carousel__percentage {
    font-size: {{ percentage_size_mobile }}px;
    font-weight: 700;
    color: {{ percentage_color }};
    line-height: 1;
    margin-bottom: {{ card_elements_spacing | times: 0.75 | round: 0 }}px;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__card-title {
    font-weight: 600;
    line-height: {{ card_title_height }}%;
    font-size: {{ card_title_size_mobile }}px;
    margin: 0 0 {{ card_elements_spacing | times: 0.75 | round: 0 }}px;
    color: {{ card_title_color }};
  }

  {% if card_title_custom %}
    #shopify-section-{{ section.id }} .vso-card-carousel__card-title {
      font-family: {{ card_title_font.family }}, {{ card_title_font.fallback_families }};
      font-weight: {{ card_title_font.weight }};
      font-style: {{ card_title_font.style }};
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-card-carousel__card-description {
    font-size: {{ card_description_size_mobile }}px;
    line-height: {{ card_description_height }}%;
    color: {{ card_description_color }};
    margin: 0;
  }

  {% if card_description_custom %}
    #shopify-section-{{ section.id }} .vso-card-carousel__card-description {
      font-family: {{ card_description_font.family }}, {{ card_description_font.fallback_families }};
      font-weight: {{ card_description_font.weight }};
      font-style: {{ card_description_font.style }};
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-card-carousel__percentage {
      font-size: {{ percentage_size }}px;
      margin-bottom: {{ card_elements_spacing }}px;
    }

    #shopify-section-{{ section.id }} .vso-card-carousel__card-title {
      font-size: {{ card_title_size }}px;
      margin: 0 0 {{ card_elements_spacing }}px;
    }

    #shopify-section-{{ section.id }} .vso-card-carousel__card-description {
      font-size: {{ card_description_size }}px;
    }
  }

  /* ── Navigation ── */
  #shopify-section-{{ section.id }} .vso-card-carousel__nav-container {
    display: none;
    align-items: center;
    margin-top: {{ nav_margin_top | times: 0.75 | round: 0 }}px;
    gap: {{ nav_line_arrow_gap }}px;
    visibility: hidden;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-card-carousel__nav-container {
      margin-top: {{ nav_margin_top }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__progress {
    flex-grow: 1;
    height: 2px;
    background: {{ progress_bg_color | default: nav_line_color }};
    position: relative;
    overflow: hidden;
    border-radius: 1px;
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__progress .bar {
    height: 100%;
    width: 0%;
    background: {{ progress_filled_color | default: nav_arrow_color }};
    transition: width 0.5s ease;
    border-radius: 1px;
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__nav {
    display: flex;
    justify-content: center;
    gap: {{ nav_arrow_gap }}px;
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__nav-button {
    width: {{ nav_arrow_size }}px;
    height: {{ nav_arrow_size }}px;
    border-radius: 50%;
    border: {{ nav_arrow_border_width | default: 1 }}px solid {{ nav_arrow_border_color }};
    background: {{ nav_arrow_bg | default: '#ffffff' }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: none;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__nav-button:focus {
    outline: none;
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__nav-button:disabled {
    opacity: .4;
  }

  #shopify-section-{{ section.id }} .vso-card-carousel__nav-button svg {
    width: {{ nav_arrow_size | times: 0.4 | round: 0 }}px;
    height: {{ nav_arrow_size | times: 0.4 | round: 0 }}px;
    color: {{ nav_arrow_color }};
  }

  /* Navigation visibility */
  {% if enable_navigation_desktop %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-card-carousel__nav-container {
        display: flex;
      }
    }
  {% endif %}

  {% if enable_navigation_mobile %}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .vso-card-carousel__nav-container {
        display: flex;
      }
    }
  {% endif %}

  {% if section.settings.disable_progress_bar_when_arrows_hidden %}
    @media screen and (min-width: 750px) {
      {% if enable_navigation_desktop == false %}
        #shopify-section-{{ section.id }} .vso-card-carousel__progress { display: none; }
      {% endif %}
    }
    @media screen and (max-width: 749px) {
      {% if enable_navigation_mobile == false %}
        #shopify-section-{{ section.id }} .vso-card-carousel__progress { display: none; }
      {% endif %}
    }
  {% endif %}
{%- endstyle -%}

{%- if request.design_mode -%}
