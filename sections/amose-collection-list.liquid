{%- liquid
  assign s = section.settings
  assign amose_install_origin = 'https://amosesection1-production.up.railway.app'
  assign amose_status_script_url = amose_install_origin | append: '/amose-section-status.js'
  assign amose_skip_install_mask = false
  if request.design_mode
    assign amose_skip_install_mask = true
  endif
  if theme.role == 'development'
    assign amose_skip_install_mask = true
  endif

  assign columns_desktop = s.columns_desktop | default: 3
  assign columns_mobile = s.columns_mobile | default: 2
-%}

{%- style -%}
  #shopify-section-{{ section.id }}.amose-cl-root {
    --cl-bg: {{ s.section_bg | default: '#f2f1ed' }};
    --cl-panel: {{ s.panel_bg | default: '#ffffff' }};
    --cl-text: {{ s.text_color | default: '#1a1a1a' }};
    --cl-muted: {{ s.muted_color | default: '#6b6b6b' }};
    --cl-overlay: {{ s.overlay_color | default: '#1a1a1a' }};
    --cl-radius: {{ s.card_radius | default: 12 }}px;
    --cl-gap: {{ s.card_gap | default: 16 }}px;
    --cl-aspect: {{ s.image_aspect_ratio | default: '4 / 5' }};
    --cl-cols: {{ columns_desktop }};
    --cl-mobile-cols: {{ columns_mobile }};
    --cl-pad-x: clamp(16px, 3vw, 28px);
    background: var(--cl-bg);
    color: var(--cl-text);
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}.amose-cl-root {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .amose-cl {
    max-width: {{ s.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 var(--cl-pad-x);
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-cl {
      {% if s.desktop_width == 'full' %}
        padding: 0;
        max-width: none;
      {% endif %}
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .amose-cl {
      {% if s.mobile_width == 'full' %}
        padding: 0;
        max-width: none;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .amose-cl__heading {
    margin: 0 0 {% if s.subtext != blank %}10px{% else %}28px{% endif %};
    text-align: {{ s.heading_alignment | default: 'left' }};
    font-size: clamp(24px, 2.8vw, {{ s.heading_size | default: 34 }}px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: {{ s.heading_weight | default: 700 }};
    color: var(--cl-text);
  }

  #shopify-section-{{ section.id }} .amose-cl__sub {
    margin: 0 0 28px;
    text-align: {{ s.heading_alignment | default: 'left' }};
    {% if s.heading_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif s.heading_alignment == 'right' %}
      margin-left: auto;
      margin-right: 0;
    {% endif %}
    max-width: 42ch;
    color: var(--cl-muted);
    font-size: {{ s.body_size | default: 15 }}px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .amose-cl__grid {
    display: grid;
    grid-template-columns: repeat(var(--cl-mobile-cols), minmax(0, 1fr));
    gap: var(--cl-gap);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-cl__grid {
      grid-template-columns: repeat(var(--cl-cols), minmax(0, 1fr));
    }
  }

  #shopify-section-{{ section.id }} .amose-cl[data-display='slider'] .amose-cl__grid {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  #shopify-section-{{ section.id }} .amose-cl[data-display='slider'] .amose-cl__grid::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .amose-cl__card {
    display: block;
    position: relative;
    border-radius: var(--cl-radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--cl-panel);
    aspect-ratio: var(--cl-aspect);
  }

  #shopify-section-{{ section.id }} .amose-cl[data-display='slider'] .amose-cl__card {
    flex: 0 0 calc((100% - (var(--cl-gap) * (var(--cl-mobile-cols) - 1))) / var(--cl-mobile-cols));
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-cl[data-display='slider'] .amose-cl__card {
      flex-basis: calc((100% - (var(--cl-gap) * (var(--cl-cols) - 1))) / var(--cl-cols));
    }
  }

  #shopify-section-{{ section.id }} .amose-cl__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .amose-cl__card:hover img {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .amose-cl__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #ececec 0%, #d8d8d8 100%);
  }

  #shopify-section-{{ section.id }} .amose-cl__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 18px 16px;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 35%,
      color-mix(in srgb, var(--cl-overlay) {{ s.overlay_opacity | default: 55 }}%, transparent) 100%
    );
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .amose-cl__title {
    margin: 0;
    font-size: clamp(16px, 2vw, {{ s.title_size | default: 20 }}px);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .amose-cl__count {
    margin: 6px 0 0;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  #shopify-section-{{ section.id }} .amose-cl__empty {
    margin: 0;
    padding: 24px 0;
    text-align: center;
    color: var(--cl-muted);
    font-size: 15px;
  }
{%- endstyle -%}

{%- unless amose_skip_install_mask -%}
{%- style -%}
  #shopify-section-{{ section.id }}.amose-section-checking {
    display: none !important;
  }
{%- endstyle -%}
{%- endunless -%}

<div class="amose-cl" data-display="{{ s.display_style | default: 'columns' }}">
  {% if s.heading != blank %}
    <h2 class="amose-cl__heading">{{ s.heading | escape }}</h2>
  {% endif %}
  {% if s.subtext != blank %}
    <p class="amose-cl__sub">{{ s.subtext | escape }}</p>
  {% endif %}

  {% assign collection_blocks = section.blocks | where: 'type', 'collection' %}
  {% if collection_blocks.size > 0 %}
    <div class="amose-cl__grid" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'collection' %}
          {% liquid
            assign card_collection = block.settings.collection
            assign card_title = block.settings.title_override
            if card_title == blank and card_collection != blank
              assign card_title = card_collection.title
            endif
            assign card_image = block.settings.image
            if card_image == blank and card_collection != blank
              if card_collection.image != blank
                assign card_image = card_collection.image
              elsif card_collection.featured_image != blank
                assign card_image = card_collection.featured_image
              endif
            endif
          %}
          {% if card_collection != blank %}
            <a
              class="amose-cl__card"
              href="{{ card_collection.url }}"
              role="listitem"
              {{ block.shopify_attributes }}
            >
              {% if card_image != blank %}
                <img
                  src="{{ card_image | image_url: width: 1000 }}"
                  alt="{{ card_image.alt | default: card_title | escape }}"
                  width="{{ card_image.width }}"
                  height="{{ card_image.height }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              {% else %}
                <div class="amose-cl__placeholder" aria-hidden="true"></div>
              {% endif %}
              <div class="amose-cl__overlay">
                {% if card_title != blank %}
                  <p class="amose-cl__title">{{ card_title | escape }}</p>
                {% endif %}
                {% if s.show_product_count and card_collection.products_count != blank %}
                  <p class="amose-cl__count">
                    {{ card_collection.products_count }}
                    {% if card_collection.products_count == 1 %}
                      {{ s.product_count_singular | default: 'product' | escape }}
                    {% else %}
                      {{ s.product_count_plural | default: 'products' | escape }}
                    {% endif %}
                  </p>
                {% endif %}
              </div>
            </a>
          {% elsif request.design_mode %}
            <div class="amose-cl__card" role="listitem" {{ block.shopify_attributes }}>
              <div class="amose-cl__placeholder" aria-hidden="true"></div>
              <div class="amose-cl__overlay">
                <p class="amose-cl__title">Collection</p>
                <p class="amose-cl__count">Select a collection</p>
              </div>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <p class="amose-cl__empty">
      {% if request.design_mode %}
        Add collection blocks to build your list.
      {% endif %}
    </p>
  {% endif %}
</div>

{%- unless amose_skip_install_mask -%}
<script>
  window.__AmoseInstallCheckPageStart = window.__AmoseInstallCheckPageStart || Date.now();
  window.__AmoseInstallCheckOrigin = {{ amose_install_origin | json }};
  window.AmoseSectionStatus = window.AmoseSectionStatus || [];
  window.AmoseSectionStatus.push({
    shop: {{ shop.permanent_domain | json }},
    sectionId: {{ section.id | json }},
    sectionType: "collection-list"
  });

  window.AmoseStatusLoaderInserted = window.AmoseStatusLoaderInserted || false;
  if (!window.AmoseStatusLoaderInserted) {
    window.AmoseStatusLoaderInserted = true;
    var script = document.createElement("script");
    script.src = {{ amose_status_script_url | json }};
    script.defer = true;
    document.head.appendChild(script);
  }
</script>
{%- endunless -%}

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "amose-cl-root",
  "max_blocks": 12,
  "settings": [
    { "type": "range", "id": "max_width", "min": 960, "max": 1600, "step": 20, "unit": "px", "label": "Max width", "default": 1200 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Browse our most-loved categories." },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 22,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 34
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "700",
      "options": [
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    { "type": "checkbox", "id": "show_product_count", "label": "Show product count", "default": true },
    { "type": "text", "id": "product_count_singular", "label": "Product count label (singular)", "default": "product" },
    { "type": "text", "id": "product_count_plural", "label": "Product count label (plural)", "default": "products" },
    { "type": "header", "content": "Cards" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select",
      "id": "display_style",
      "label": "Display style",
      "default": "columns",
      "options": [
        { "value": "columns", "label": "Columns" },
        { "value": "slider", "label": "Slider" }
      ]
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image format",
      "default": "4 / 5",
      "options": [
        { "value": "1 / 1", "label": "1:1 (Square)" },
        { "value": "4 / 5", "label": "4:5 (Portrait)" },
        { "value": "3 / 4", "label": "3:4 (Portrait)" },
        { "value": "16 / 10", "label": "16:10 (Landscape)" }
      ]
    },
    { "type": "range", "id": "card_gap", "min": 8, "max": 32, "step": 1, "unit": "px", "label": "Card gap", "default": 16 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 32, "step": 1, "unit": "px", "label": "Card radius", "default": 12 },
    { "type": "range", "id": "title_size", "min": 16, "max": 28, "step": 1, "unit": "px", "label": "Title size", "default": 20 },
    { "type": "range", "id": "body_size", "min": 13, "max": 18, "step": 1, "unit": "px", "label": "Subtext size", "default": 15 },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "default": 55
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop width",
      "default": "container",
      "options": [
        { "value": "container", "label": "In container" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile width",
      "default": "container",
      "options": [
        { "value": "container", "label": "In container" },
        { "value": "full", "label": "Full width" }
      ]
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#f2f1ed" },
    { "type": "color", "id": "panel_bg", "label": "Card fallback", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Heading", "default": "#1a1a1a" },
    { "type": "color", "id": "muted_color", "label": "Subtext", "default": "#6b6b6b" },
    { "type": "color", "id": "overlay_color", "label": "Image overlay", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" },
        { "type": "text", "id": "title_override", "label": "Custom title (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
