{%- liquid
  assign s = section.settings
  assign amose_install_origin = 'https://amosesection1-production.up.railway.app'
  assign amose_status_script_url = amose_install_origin | append: '/amose-section-status.js'
  assign amose_skip_install_mask = false
  if request.design_mode
    assign amose_skip_install_mask = true
  endif
  if theme.role == 'development'
    assign amose_skip_install_mask = true
  endif
  assign star_count = s.star_rating | default: 5 | plus: 0
  if star_count < 1
    assign star_count = 1
  endif
  if star_count > 5
    assign star_count = 5
  endif
  assign rating_display = s.rating_display | default: ''
  if rating_display == blank
    if s.show_stars
      assign rating_display = 'stars'
    else
      assign rating_display = 'none'
    endif
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }}.amose-image-text-root {
    --aix-page-bg: {{ s.section_bg | default: '#ffffff' }};
    --aix-panel-bg: {{ s.panel_bg | default: '#f2f1ed' }};
    --aix-text: {{ s.text_color | default: '#1a1a1a' }};
    --aix-muted: {{ s.muted_text_color | default: '#6b6b6b' }};
    --aix-star: {{ s.star_color | default: '#1a1a1a' }};
    --aix-icon: {{ s.icon_color | default: '#1a1a1a' }};
    --aix-icon-bg: {{ s.icon_bg_color | default: 'transparent' }};
    --aix-benefit: {{ s.benefit_text_color | default: '#1a1a1a' }};
    --aix-btn-bg: {{ s.button_bg | default: '#1a1a1a' }};
    --aix-btn-text: {{ s.button_text_color | default: '#ffffff' }};
    --aix-btn-radius: {{ s.button_border_radius | default: 40 }}px;
    --aix-radius: {{ s.corner_radius | default: 20 }}px;
    --aix-gap: {{ s.column_gap | default: 12 }}px;
    --aix-pad-x: clamp(16px, 3vw, 28px);
    background: var(--aix-page-bg);
    color: var(--aix-text);
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}.amose-image-text-root {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .amose-aix {
    max-width: {{ s.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 var(--aix-pad-x);
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-aix {
      {% if s.desktop_width == 'full' %}
        padding: 0;
        max-width: none;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .amose-aix__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--aix-gap);
    align-items: stretch;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-aix__layout {
      grid-template-columns: 1fr 1fr;
      min-height: {{ s.min_height | default: 520 }}px;
    }

    #shopify-section-{{ section.id }} .amose-aix__panel {
      {% if s.image_position == 'left' %}
        order: 2;
      {% else %}
        order: 1;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .amose-aix__media {
      {% if s.image_position == 'left' %}
        order: 1;
      {% else %}
        order: 2;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .amose-aix__panel {
    background: var(--aix-panel-bg);
    {% if s.column_gap == 0 %}
      {% if s.image_position == 'left' %}
        border-radius: 0 var(--aix-radius) var(--aix-radius) 0;
      {% else %}
        border-radius: var(--aix-radius) 0 0 var(--aix-radius);
      {% endif %}
    {% else %}
      border-radius: var(--aix-radius);
    {% endif %}
    padding: clamp(28px, 4vw, 48px) clamp(24px, 3.5vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .amose-aix__copy {
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .amose-aix__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .amose-aix__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--aix-star);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .amose-aix__stars svg {
    width: {{ s.star_size | default: 16 }}px;
    height: {{ s.star_size | default: 16 }}px;
    fill: currentColor;
    display: block;
  }

  #shopify-section-{{ section.id }} .amose-aix__rating-text {
    margin: 0;
    font-size: {{ s.rating_text_size | default: 14 }}px;
    line-height: 1.3;
    color: var(--aix-muted);
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .amose-aix__tp-label {
    font-size: {{ s.rating_text_size | default: 14 }}px;
    font-weight: 600;
    color: var(--aix-text);
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .amose-aix__tp-badge {
    display: block;
    width: auto;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .amose-aix__tp-count {
    margin: 0;
    font-size: {{ s.rating_text_size | default: 14 }}px;
    line-height: 1.3;
    color: var(--aix-muted);
  }

  #shopify-section-{{ section.id }} .amose-aix__tp-count strong {
    color: var(--aix-text);
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .amose-aix__title {
    margin: 0 0 14px;
    font-size: clamp(28px, 3.2vw, {{ s.heading_size | default: 42 }}px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: {{ s.heading_weight | default: 700 }};
    color: var(--aix-text);
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
  }

  #shopify-section-{{ section.id }} .amose-aix__description {
    margin: 0;
    font-size: {{ s.body_size | default: 15 }}px;
    line-height: 1.55;
    color: var(--aix-muted);
  }

  #shopify-section-{{ section.id }} .amose-aix__description p {
    margin: 0 0 0.7em;
  }

  #shopify-section-{{ section.id }} .amose-aix__description p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .amose-aix__benefits {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ s.benefit_gap | default: 12 }}px;
  }

  #shopify-section-{{ section.id }} .amose-aix__benefit {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--aix-benefit);
    font-size: {{ s.benefit_font_size | default: 15 }}px;
    line-height: 1.35;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .amose-aix__icon {
    flex-shrink: 0;
    width: {{ s.icon_size | default: 22 }}px;
    height: {{ s.icon_size | default: 22 }}px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--aix-icon-bg);
    color: var(--aix-icon);
  }

  #shopify-section-{{ section.id }} .amose-aix__icon .ph {
    font-size: calc({{ s.icon_size | default: 22 }}px * 0.72);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .amose-aix__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
    width: auto;
    max-width: 100%;
    padding: {{ s.button_padding_y | default: 14 }}px {{ s.button_padding_x | default: 24 }}px;
    border: {% if s.button_style == 'outline' %}1.5px solid var(--aix-btn-bg){% else %}0{% endif %};
    border-radius: {% if s.button_border_radius >= 36 %}999px{% else %}var(--aix-btn-radius){% endif %};
    text-decoration: none;
    font-weight: {{ s.button_font_weight | default: 600 }};
    font-size: {{ s.button_font_size | default: 15 }}px;
    line-height: 1.2;
    background: {% if s.button_style == 'outline' %}transparent{% else %}var(--aix-btn-bg){% endif %};
    color: {% if s.button_style == 'outline' %}var(--aix-btn-bg){% else %}var(--aix-btn-text){% endif %};
    box-sizing: border-box;
    transition: transform 0.15s ease, opacity 0.15s ease, background 0.15s ease, color 0.15s ease;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .amose-aix__cta:hover {
    transform: translateY(-1px);
    opacity: 0.94;
    {% if s.button_style == 'outline' %}
      background: var(--aix-btn-bg);
      color: var(--aix-btn-text);
    {% endif %}
  }

  #shopify-section-{{ section.id }} .amose-aix__media {
    position: relative;
    {% if s.column_gap == 0 %}
      {% if s.image_position == 'left' %}
        border-radius: var(--aix-radius) 0 0 var(--aix-radius);
      {% else %}
        border-radius: 0 var(--aix-radius) var(--aix-radius) 0;
      {% endif %}
    {% else %}
      border-radius: var(--aix-radius);
    {% endif %}
    overflow: hidden;
    background: #e5e5e5;
    width: 100%;
    min-height: 0;
    aspect-ratio: {{ s.image_aspect_ratio | default: '1 / 1' }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-aix__media {
      min-height: 0;
      height: auto;
      aspect-ratio: {{ s.desktop_image_aspect_ratio | default: '4 / 5' }};
      align-self: stretch;
    }
  }

  #shopify-section-{{ section.id }} .amose-aix__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .amose-aix__placeholder {
    width: 100%;
    height: 100%;
    min-height: 320px;
    background: linear-gradient(145deg, #e8e8e8 0%, #d4d4d4 100%);
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .amose-aix {
      {% if s.mobile_width == 'full' %}
        padding: 0;
        max-width: none;
      {% else %}
        padding: 0 var(--aix-pad-x);
      {% endif %}
    }

    #shopify-section-{{ section.id }} .amose-aix__layout {
      gap: 0;
    }

    #shopify-section-{{ section.id }} .amose-aix__media {
      {% if s.mobile_image_position == 'after' %}
        order: 2;
      {% else %}
        order: 1;
      {% endif %}
      min-height: 0;
      aspect-ratio: {{ s.image_aspect_ratio | default: '1 / 1' }};
      {% if s.mobile_width == 'full' %}
        border-radius: 0;
      {% elsif s.mobile_image_position == 'after' %}
        border-radius: 0 0 var(--aix-radius) var(--aix-radius);
      {% else %}
        border-radius: var(--aix-radius) var(--aix-radius) 0 0;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .amose-aix__panel {
      {% if s.mobile_image_position == 'after' %}
        order: 1;
      {% else %}
        order: 2;
      {% endif %}
      padding: 24px 22px 22px;
      {% if s.mobile_width == 'full' %}
        border-radius: 0;
      {% elsif s.mobile_image_position == 'after' %}
        border-radius: var(--aix-radius) var(--aix-radius) 0 0;
      {% else %}
        border-radius: 0 0 var(--aix-radius) var(--aix-radius);
      {% endif %}
    }

    #shopify-section-{{ section.id }} .amose-aix__copy {
      max-width: none;
    }

    #shopify-section-{{ section.id }} .amose-aix__title {
      margin-bottom: 10px;
      font-size: clamp(26px, 8vw, 34px);
    }
  }
{%- endstyle -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css">

{%- unless amose_skip_install_mask -%}
{%- style -%}
  #shopify-section-{{ section.id }}.amose-section-checking {
    display: none !important;
  }
{%- endstyle -%}
{%- endunless -%}

<div class="amose-aix">
  <div class="amose-aix__layout">
    <div class="amose-aix__panel">
      <div class="amose-aix__copy">
        {% if rating_display == 'stars' %}
          <div class="amose-aix__rating">
            <div class="amose-aix__stars" aria-label="{{ star_count }} out of 5 stars">
              {% for i in (1..star_count) %}
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M12.0006 18.26L4.94715 22.2082L6.52248 14.2799L0.587891 8.7918L8.61493 7.84006L12.0006 0.5L15.3862 7.84006L23.4132 8.7918L17.4787 14.2799L19.054 22.2082L12.0006 18.26Z"/>
                </svg>
              {% endfor %}
            </div>
            {% if s.rating_text != blank %}
              <p class="amose-aix__rating-text">{{ s.rating_text | escape }}</p>
            {% endif %}
          </div>
        {% elsif rating_display == 'trustpilot' %}
          <div class="amose-aix__rating" role="img" aria-label="{{ s.trustpilot_rating | default: '4.8' }} out of 5 on Trustpilot">
            {% if s.trustpilot_label != blank %}
              <span class="amose-aix__tp-label">{{ s.trustpilot_label | escape }}</span>
            {% endif %}
            <img
              class="amose-aix__tp-badge"
              src="{% if s.trustpilot_badge_image != blank %}{{ s.trustpilot_badge_image }}{% else %}https://i.imgur.com/EHjNmTM.png{% endif %}"
              width="100"
              height="20"
              alt=""
              loading="lazy"
              decoding="async"
            >
            <p class="amose-aix__tp-count">
              <strong>{{ s.trustpilot_review_count | default: '1,284' }}</strong>
              <span> {{ s.trustpilot_reviews_label | default: 'reviews' }}</span>
            </p>
          </div>
        {% endif %}

        {% if s.heading != blank %}
          <h2 class="amose-aix__title">{{ s.heading | escape }}</h2>
        {% endif %}

        {% if s.description != blank %}
          <div class="amose-aix__description">
            {{ s.description | newline_to_br }}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <ul class="amose-aix__benefits">
            {% for block in section.blocks %}
              {% if block.type == 'benefit' and block.settings.text != blank %}
                <li class="amose-aix__benefit" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank and block.settings.icon != 'none' %}
                    <span class="amose-aix__icon" aria-hidden="true">
                      <i class="ph ph-{{ block.settings.icon }}"></i>
                    </span>
                  {% endif %}
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if s.show_button and s.button_label != blank %}
          {% if s.button_link != blank %}
            <a
              class="amose-aix__cta"
              href="{{ s.button_link }}"
            >
              {{ s.button_label | escape }}
            </a>
          {% else %}
            <span class="amose-aix__cta">{{ s.button_label | escape }}</span>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="amose-aix__media">
      {% if s.image != blank %}
        <img
          src="{{ s.image | image_url: width: 1600 }}"
          alt="{{ s.image.alt | escape }}"
          width="{{ s.image.width }}"
          height="{{ s.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="amose-aix__placeholder" aria-hidden="true"></div>
      {% endif %}
    </div>
  </div>
</div>

{%- unless amose_skip_install_mask -%}
<script>
  window.__AmoseInstallCheckPageStart = window.__AmoseInstallCheckPageStart || Date.now();
  window.__AmoseInstallCheckOrigin = {{ amose_install_origin | json }};
  window.AmoseSectionStatus = window.AmoseSectionStatus || [];
  window.AmoseSectionStatus.push({
    shop: {{ shop.permanent_domain | json }},
    sectionId: {{ section.id | json }},
    sectionType: "image-with-text"
  });

  window.AmoseStatusLoaderInserted = window.AmoseStatusLoaderInserted || false;
  if (!window.AmoseStatusLoaderInserted) {
    window.AmoseStatusLoaderInserted = true;
    var script = document.createElement("script");
    script.src = {{ amose_status_script_url | json }};
    script.defer = true;
    document.head.appendChild(script);
  }
</script>
{%- endunless -%}

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "amose-image-text-root",
  "settings": [
    { "type": "range", "id": "max_width", "min": 960, "max": 1600, "step": 20, "unit": "px", "label": "Max width", "default": 1200 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Title", "default": "clean ingredients" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Formulated without harsh chemicals. Only clean, skin-loving ingredients you can trust."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 42
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Title weight",
      "default": "700",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 15
    },
    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_button", "label": "Show button", "default": true },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ]
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 15
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Button text weight",
      "default": "600",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Button radius",
      "default": 40
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Button padding left/right",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Button padding top/bottom",
      "default": 14
    },
    { "type": "header", "content": "Rating" },
    {
      "type": "select",
      "id": "rating_display",
      "label": "Rating style",
      "default": "stars",
      "options": [
        { "value": "stars", "label": "Stars" },
        { "value": "trustpilot", "label": "Trustpilot" },
        { "value": "none", "label": "Hidden" }
      ]
    },
    {
      "type": "range",
      "id": "star_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stars",
      "default": 5
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Star size",
      "default": 16
    },
    { "type": "text", "id": "rating_text", "label": "Star rating text", "default": "4.9/5 from 1,200+ reviews" },
    {
      "type": "range",
      "id": "rating_text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Rating text size",
      "default": 14
    },
    { "type": "text", "id": "trustpilot_label", "label": "Trustpilot label", "default": "Excellent" },
    { "type": "text", "id": "trustpilot_rating", "label": "Trustpilot rating", "default": "4.8" },
    { "type": "text", "id": "trustpilot_review_count", "label": "Trustpilot review count", "default": "1,284" },
    { "type": "text", "id": "trustpilot_reviews_label", "label": "Trustpilot reviews label", "default": "reviews" },
    { "type": "text", "id": "trustpilot_badge_image", "label": "Trustpilot badge image URL" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "right",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Image position (mobile)",
      "default": "before",
      "options": [
        { "value": "before", "label": "Before content" },
        { "value": "after", "label": "After content" }
      ]
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Mobile image format",
