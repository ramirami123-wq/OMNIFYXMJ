{%- liquid
  assign s = section.settings
  assign amose_install_origin = 'https://amosesection1-production.up.railway.app'
  assign amose_status_script_url = amose_install_origin | append: '/amose-section-status.js'
  assign amose_skip_install_mask = false
  if request.design_mode
    assign amose_skip_install_mask = true
  endif
  if theme.role == 'development'
    assign amose_skip_install_mask = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }}.amose-benefits-image-root {
    --abi-page-bg: {{ s.section_bg | default: '#ffffff' }};
    --abi-panel-bg: {{ s.panel_bg | default: '#f2f1ed' }};
    --abi-text: {{ s.text_color | default: '#1a1a1a' }};
    --abi-muted: {{ s.muted_text_color | default: '#6b6b6b' }};
    --abi-icon: {{ s.icon_color | default: '#1a1a1a' }};
    --abi-radius: {{ s.corner_radius | default: 20 }}px;
    --abi-gap: {{ s.column_gap | default: 12 }}px;
    --abi-pad-x: clamp(16px, 3vw, 28px);
    background: var(--abi-page-bg);
    color: var(--abi-text);
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}.amose-benefits-image-root {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .amose-abi {
    max-width: {{ s.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 var(--abi-pad-x);
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-abi {
      {% if s.desktop_width == 'full' %}
        padding: 0;
        max-width: none;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .amose-abi__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--abi-gap);
    align-items: stretch;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-abi__layout {
      grid-template-columns: 1fr 1fr;
      min-height: {{ s.min_height | default: 520 }}px;
    }

    #shopify-section-{{ section.id }} .amose-abi__panel {
      {% if s.image_position == 'left' %}
        order: 2;
      {% else %}
        order: 1;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .amose-abi__media {
      {% if s.image_position == 'left' %}
        order: 1;
      {% else %}
        order: 2;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .amose-abi__panel {
    background: var(--abi-panel-bg);
    {% if s.column_gap == 0 %}
      {% if s.image_position == 'left' %}
        border-radius: 0 var(--abi-radius) var(--abi-radius) 0;
      {% else %}
        border-radius: var(--abi-radius) 0 0 var(--abi-radius);
      {% endif %}
    {% else %}
      border-radius: var(--abi-radius);
    {% endif %}
    padding: clamp(28px, 4vw, 48px) clamp(24px, 3.5vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .amose-abi__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--abi-muted);
  }

  #shopify-section-{{ section.id }} .amose-abi__title {
    margin: 0 0 24px;
    font-size: clamp(26px, 3vw, {{ s.heading_size | default: 36 }}px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: {{ s.heading_weight | default: 700 }};
    color: var(--abi-text);
  }

  #shopify-section-{{ section.id }} .amose-abi__benefits {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ s.benefit_gap | default: 22 }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-abi__benefits {
      {% if s.benefits_columns == '2' %}
        grid-template-columns: 1fr 1fr;
        column-gap: 20px;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .amose-abi__benefit {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .amose-abi__benefit-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .amose-abi__icon {
    flex-shrink: 0;
    color: var(--abi-icon);
    font-size: {{ s.icon_size | default: 18 }}px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .amose-abi__benefit-title {
    margin: 0;
    font-size: {{ s.benefit_title_size | default: 15 }}px;
    line-height: 1.3;
    font-weight: 700;
    color: var(--abi-text);
  }

  #shopify-section-{{ section.id }} .amose-abi__benefit-text,
  #shopify-section-{{ section.id }} .amose-abi__benefit-text p {
    margin: 0;
    font-size: {{ s.benefit_text_size | default: 14 }}px;
    line-height: 1.5;
    color: var(--abi-muted);
  }

  #shopify-section-{{ section.id }} .amose-abi__benefit-text p + p {
    margin-top: 0.5em;
  }

  #shopify-section-{{ section.id }} .amose-abi__media {
    position: relative;
    {% if s.column_gap == 0 %}
      {% if s.image_position == 'left' %}
        border-radius: var(--abi-radius) 0 0 var(--abi-radius);
      {% else %}
        border-radius: 0 var(--abi-radius) var(--abi-radius) 0;
      {% endif %}
    {% else %}
      border-radius: var(--abi-radius);
    {% endif %}
    overflow: hidden;
    background: #e5e5e5;
    width: 100%;
    min-height: 0;
    aspect-ratio: {{ s.image_aspect_ratio | default: '1 / 1' }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amose-abi__media {
      min-height: 0;
      height: auto;
      aspect-ratio: {{ s.desktop_image_aspect_ratio | default: '4 / 5' }};
      align-self: stretch;
    }
  }

  #shopify-section-{{ section.id }} .amose-abi__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .amose-abi__placeholder {
    width: 100%;
    height: 100%;
    min-height: 320px;
    background: linear-gradient(145deg, #e8e8e8 0%, #d4d4d4 100%);
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .amose-abi {
      {% if s.mobile_width == 'full' %}
        padding: 0;
        max-width: none;
      {% else %}
        padding: 0 var(--abi-pad-x);
      {% endif %}
    }

    #shopify-section-{{ section.id }} .amose-abi__layout {
      gap: 0;
    }

    #shopify-section-{{ section.id }} .amose-abi__media {
      {% if s.mobile_image_position == 'after' %}
        order: 2;
      {% else %}
        order: 1;
      {% endif %}
      min-height: 0;
      aspect-ratio: {{ s.image_aspect_ratio | default: '1 / 1' }};
      {% if s.mobile_width == 'full' %}
        border-radius: 0;
      {% elsif s.mobile_image_position == 'after' %}
        border-radius: 0 0 var(--abi-radius) var(--abi-radius);
      {% else %}
        border-radius: var(--abi-radius) var(--abi-radius) 0 0;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .amose-abi__panel {
      {% if s.mobile_image_position == 'after' %}
        order: 1;
      {% else %}
        order: 2;
      {% endif %}
      padding: 24px 22px 22px;
      {% if s.mobile_width == 'full' %}
        border-radius: 0;
      {% elsif s.mobile_image_position == 'after' %}
        border-radius: var(--abi-radius) var(--abi-radius) 0 0;
      {% else %}
        border-radius: 0 0 var(--abi-radius) var(--abi-radius);
      {% endif %}
    }

    #shopify-section-{{ section.id }} .amose-abi__title {
      margin-bottom: 18px;
      font-size: clamp(24px, 7vw, 32px);
    }
  }
{%- endstyle -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css">

{%- unless amose_skip_install_mask -%}
{%- style -%}
  #shopify-section-{{ section.id }}.amose-section-checking {
    display: none !important;
  }
{%- endstyle -%}
{%- endunless -%}

<div class="amose-abi">
  <div class="amose-abi__layout">
    <div class="amose-abi__panel">
      {% if s.eyebrow != blank %}
        <p class="amose-abi__eyebrow">{{ s.eyebrow | escape }}</p>
      {% endif %}
      {% if s.heading != blank %}
        <h2 class="amose-abi__title">{{ s.heading | escape }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <ul class="amose-abi__benefits">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <li class="amose-abi__benefit" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <div class="amose-abi__benefit-head">
                    {% if block.settings.icon != blank and block.settings.icon != 'none' %}
                      <span class="amose-abi__icon" aria-hidden="true">
                        <i class="ph ph-{{ block.settings.icon }}"></i>
                      </span>
                    {% endif %}
                    <h3 class="amose-abi__benefit-title">{{ block.settings.title | escape }}</h3>
                  </div>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="amose-abi__benefit-text">{{ block.settings.text }}</div>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="amose-abi__media">
      {% if s.image != blank %}
        <img
          src="{{ s.image | image_url: width: 1600 }}"
          alt="{{ s.image.alt | escape }}"
          width="{{ s.image.width }}"
          height="{{ s.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="amose-abi__placeholder" aria-hidden="true"></div>
      {% endif %}
    </div>
  </div>
</div>

{%- unless amose_skip_install_mask -%}
<script>
  window.__AmoseInstallCheckPageStart = window.__AmoseInstallCheckPageStart || Date.now();
  window.__AmoseInstallCheckOrigin = {{ amose_install_origin | json }};
  window.AmoseSectionStatus = window.AmoseSectionStatus || [];
  window.AmoseSectionStatus.push({
    shop: {{ shop.permanent_domain | json }},
    sectionId: {{ section.id | json }},
    sectionType: "benefits-with-image"
  });

  window.AmoseStatusLoaderInserted = window.AmoseStatusLoaderInserted || false;
  if (!window.AmoseStatusLoaderInserted) {
    window.AmoseStatusLoaderInserted = true;
    var script = document.createElement("script");
    script.src = {{ amose_status_script_url | json }};
    script.defer = true;
    document.head.appendChild(script);
  }
</script>
{%- endunless -%}

