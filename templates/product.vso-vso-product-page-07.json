        "faq_item_1_6Lgnmc": {
          "type": "faq_item",
          "settings": {
            "question": "Will it block out light completely?",
            "answer": "<p>Yes — the Versio Sleep Mask is engineered for 100% blackout. The contoured design sits away from your eyes and the opaque silk-blend fabric eliminates all light leakage, even in bright environments.</p>"
          }
        },
        "faq_item_2_r43Fis": {
          "type": "faq_item",
          "settings": {
            "question": "Is it comfortable to wear all night?",
            "answer": "<p>Absolutely. The contoured shape means the mask never touches your eyelids, and the ultra-soft silk-blend fabric is gentle on even the most sensitive skin. Most customers forget they're wearing it.</p>"
          }
        },
        "faq_item_3_15ysl8": {
          "type": "faq_item",
          "settings": {
            "question": "Will it fit my head size?",
            "answer": "<p>The Versio Sleep Mask features a fully adjustable strap that fits most head sizes comfortably. Whether you sleep on your back or side, the strap keeps the mask securely in place all night without feeling tight.</p>"
          }
        },
        "faq_item_4_CoBlu0": {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer a satisfaction guarantee?",
            "answer": "<p>Yes — we offer a 30-day satisfaction guarantee. If you're not sleeping better with the Versio Sleep Mask, return it within 30 days for a full refund. No questions asked.</p>"
          }
        },
        "faq_item_5_LiQB4a": {
          "type": "faq_item",
          "settings": {
            "question": "How do I care for my sleep mask?",
            "answer": "<p>Hand wash cold with mild detergent and lay flat to dry. Do not bleach, tumble dry, or iron directly on the fabric to preserve the silk-blend material.</p>"
          }
        },
        "faq_item_6_NZEzYc": {
          "type": "faq_item",
          "settings": {
            "question": "What is your shipping and return policy?",
            "answer": "<p>We offer free standard shipping on all orders. Easy 30-day returns — no questions asked. Sleep better or your money back.</p>"
          }
        }
      },
